{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口权限：核心能力、标题栏拖动与窗口主题、文件选择对话框、写入剪贴板",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text"
  ]
}
